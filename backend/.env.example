SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PASSWORD=
# Optional: override the auto-composed Postgres URL for ETL.
# Useful when the pooler endpoint (port 6543) is needed instead of direct (5432).
DATABASE_URL=
COMPSTAT_DATA_DIR=/path/to/claude_impact_lab_compstat_rio/dados
REPLICATE_API_TOKEN=
GLM_OCR_MODEL_VERSION=305df8d2d6079c27d03dea1c5e716382005153889bcebb5dbc32d1356cbd4eac
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CORS_ORIGINS=*
LOG_LEVEL=info
# Absolute path to the directory holding the source CSVs.
# Leave blank to use the repo default: <repo>/claude_impact_lab_compstat_rio/dados
DATA_DIR=
# GCP service account JSON for accessing public BigQuery datasets (1746 chamados).
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
